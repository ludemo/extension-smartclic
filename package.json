{
  "name": "smartclic-storybook",
  "displayName": "smartclic-devtools",
  "publisher": "angelzevallos",
  "description": "In55telliSense y guías para componentes UI",
  "version": "0.2.3",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "icon": "icon.webp",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:vue",
    "onLanguage:html",
    "onLanguage:scss"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "smartclic.importmapView",
          "name": "Import Map",
          "icon": "$(symbol-structure)"
        }
      ]
    },
    "commands": [
      {
        "command": "smartclic.scaffoldComponent",
        "title": "Smartclic: Crear Componente"
      },
      {
        "command": "smartclic.scss.fixAndSave",
        "title": "Smartclic: Guardar con autofix SCSS"
      },
      {
        "command": "smartclic.importmap.refresh",
        "title": "Recargar",
        "icon": "$(refresh)"
      },
      {
        "command": "smartclic.importmap.allLocal",
        "title": "Todo local",
        "icon": "$(home)"
      },
      {
        "command": "smartclic.importmap.allDev",
        "title": "Todo dev",
        "icon": "$(cloud)"
      },
      {
        "command": "smartclic.importmap.toggle",
        "title": "Cambiar",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "smartclic.importmap.toggleIp",
        "title": "Cambiar IP",
        "icon": "$(vm-connect)"
      },
      {
        "command": "smartclic.importmap.startMfe",
        "title": "Iniciar MFE",
        "icon": "$(play)"
      },
      {
        "command": "smartclic.importmap.stopMfe",
        "title": "Detener MFE",
        "icon": "$(primitive-square)"
      },
      {
        "command": "smartclic.importmap.killExternal",
        "title": "Detener MFE (externo)",
        "icon": "$(primitive-square)"
      },
      {
        "command": "smartclic.importmap.buildLibrary",
        "title": "Build + Publicar librería en yalc",
        "icon": "$(beaker)"
      },
      {
        "command": "smartclic.importmap.stopBuildLibrary",
        "title": "Detener build",
        "icon": "$(primitive-square)"
      },
      {
        "command": "smartclic.importmap.yalcAdd",
        "title": "Usar yalc local",
        "icon": "$(plug)"
      },
      {
        "command": "smartclic.importmap.yalcUpdate",
        "title": "Actualizar desde yalc",
        "icon": "$(sync)"
      },
      {
        "command": "smartclic.importmap.yalcRemove",
        "title": "Quitar yalc",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "smartclic.importmap.showOutput",
        "title": "Ver logs",
        "icon": "$(output)"
      },
      {
        "command": "smartclic.importmap.startStorybook",
        "title": "Iniciar Storybook",
        "icon": "$(play-circle)"
      },
      {
        "command": "smartclic.importmap.stopStorybook",
        "title": "Detener Storybook",
        "icon": "$(stop-circle)"
      },
      {
        "command": "smartclic.importmap.showStorybookOutput",
        "title": "Ver logs de Storybook",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "smartclic.scaffoldComponent",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "smartclic.importmap.allLocal",
          "when": "view == smartclic.importmapView",
          "group": "navigation@1"
        },
        {
          "command": "smartclic.importmap.allDev",
          "when": "view == smartclic.importmapView",
          "group": "navigation@2"
        },
        {
          "command": "smartclic.importmap.refresh",
          "when": "view == smartclic.importmapView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "smartclic.importmap.toggle",
          "when": "view == smartclic.importmapView && viewItem =~ /cantoggle/",
          "group": "inline"
        },
        {
          "command": "smartclic.importmap.startMfe",
          "when": "view == smartclic.importmapView && viewItem =~ /local-offline/",
          "group": "inline"
        },
        {
          "command": "smartclic.importmap.stopMfe",
          "when": "view == smartclic.importmapView && viewItem =~ /^mfe.*hasprocess/",
          "group": "inline"
        },
        {
          "command": "smartclic.importmap.showOutput",
          "when": "view == smartclic.importmapView && viewItem =~ /^mfe.*hasprocess/",
          "group": "inline"
        },
        {
          "command": "smartclic.importmap.toggleIp",
          "when": "view == smartclic.importmapView && viewItem == ipMode",
          "group": "inline"
        },
        {
          "command": "smartclic.importmap.buildLibrary",
          "when": "view == smartclic.importmapView && viewItem =~ /^library/ && !(viewItem =~ /building/)",
          "group": "inline"
        },
        {
          "command": "smartclic.importmap.stopBuildLibrary",
          "when": "view == smartclic.importmapView && viewItem =~ /^library.*building/",
          "group": "inline"
        },
        {
          "command": "smartclic.importmap.startStorybook",
          "when": "view == smartclic.importmapView && viewItem =~ /sb-offline/",
          "group": "inline"
        },
        {
          "command": "smartclic.importmap.stopStorybook",
          "when": "view == smartclic.importmapView && viewItem =~ /sb-hasprocess|sb-external/",
          "group": "inline"
        },
        {
          "command": "smartclic.importmap.showStorybookOutput",
          "when": "view == smartclic.importmapView && viewItem =~ /sb-hasprocess/",
          "group": "inline"
        },
        {
          "command": "smartclic.importmap.yalcAdd",
          "when": "view == smartclic.importmapView && viewItem =~ /-nexus/",
          "group": "inline"
        },
        {
          "command": "smartclic.importmap.yalcUpdate",
          "when": "view == smartclic.importmapView && viewItem =~ /-yalc/",
          "group": "inline"
        },
        {
          "command": "smartclic.importmap.yalcRemove",
          "when": "view == smartclic.importmapView && viewItem =~ /-yalc/",
          "group": "inline"
        }
      ]
    },
    "snippets": [
      {
        "language": "scss",
        "path": "./snippets/scss.json"
      }
    ],
    "keybindings": [
      {
        "command": "smartclic.scss.fixAndSave",
        "key": "ctrl+alt+s",
        "when": "editorLangId == scss && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Smartclic Dev Tools",
      "properties": {
        "smartclic.scss.autoFixOnSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Aplicar autofix SCSS al guardar normalmente (`Ctrl+S`). Si está desactivado, usar el atajo `Ctrl+Alt+S` (modificable en _Atajos de teclado_ → buscar `smartclic.scss.fixAndSave`)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}